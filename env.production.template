# Production Environment Variables Template for cPanel Deployment
# Copy this file and create .env.production with your actual credentials

# Database Configuration
DB_HOST=    
DB_USER=your_cpanel_db_user
DB_PASS=your_cpanel_db_password
DB_NAME=your_cpanel_db_name

# Server Configuration
PORT=3001
NODE_ENV=production

# Admin Authentication (required — app will refuse to start auth without these)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
ADMIN_USER=replace_with_admin_username
ADMIN_PASS=replace_with_strong_password

# Instagram Integration (optional)
INSTAGRAM_USER_ID=your_instagram_user_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
